{
  "name": "UCI Java Programming",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/setup-db.sh",

  "remoteEnv": {
    "UCI_DB_USER": "javauser",
    "UCI_DB_PASSWORD": "JavaClass2026",
    "UCI_DB_URL": "jdbc:mariadb://127.0.0.1:3306/University",
    "UCI_LIBRARY_DB_URL": "jdbc:mariadb://127.0.0.1:3306/library_db"
  }
}
